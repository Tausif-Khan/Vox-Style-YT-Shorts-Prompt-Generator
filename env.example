# ============================================================================
# Format Lab — configuration template
# ----------------------------------------------------------------------------
# Copy to `.env.local` for local development (`.env` / `.env.local` are git-
# ignored; this template is committed on purpose and contains NO secrets).
#
# TWO buckets — do not mix them:
#
#   (1) VITE_*  →  PUBLIC. Vite inlines these into the browser bundle.
#                  Anything here is visible to every visitor. Never put a
#                  secret in a VITE_ variable.
#
#   (2) no prefix →  PRIVATE. Read only inside the Convex backend with
#                  process.env (set via `bunx convex env set KEY value` or
#                  Settings → Environment). The browser can never see these.
# ============================================================================

# ── (1) PUBLIC — browser bundle ─────────────────────────────────────────────

# Convex deployment URL (frontend). `bun convex dev` rewrites this locally;
# production builds read it from here.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL (HTTP actions, e.g. POST /session for the visitor cookie).
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Advertising (Adsterra is the active provider; flip to adsense to switch) ─
VITE_AD_PROVIDER_SIDEBAR=adsterra
VITE_AD_PROVIDER_BANNER=adsterra
# Adsterra keys (https://adsterra.com)
VITE_ADSTERRA_SIDEBAR_KEY=
VITE_ADSTERRA_BANNER_KEY=
# AdSense (only needed when a provider above is set to `adsense`)
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SIDEBAR_SLOT=
VITE_ADSENSE_BANNER_SLOT=

# ── (2) PRIVATE — Convex backend only (`bunx convex env set KEY value`) ─────

# OpenRouter — the private key. Server-side only; never VITE_-prefixed.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
# Optional overrides (defaults shown)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# Signing secret for visitor tokens (HttpOnly cookie / session token).
# If unset the backend falls back to OPENROUTER_API_KEY — set your own random
# value in production:  openssl rand -hex 32
APP_IDENTITY_SECRET=

# Allowed browser origins for credentialed /session calls (comma separated).
# REQUIRED in production, e.g. https://your-domain.example
APP_ALLOWED_ORIGINS=

# ── Application limits (owner-tunable; NOT OpenRouter's own limits) ─────────
# Changing these never resets counters already consumed.
APP_PER_MINUTE_CAP=10          # global upstream requests per rolling minute
APP_DAILY_CAP=40               # global upstream requests per calendar day
APP_IP_PER_MINUTE_CAP=5        # per hashed client IP, per rolling minute
APP_IP_DAILY_CAP=20            # per hashed client IP, per day
APP_MAX_CONCURRENT=3           # simultaneous in-flight upstream requests
APP_REGEN_COOLDOWN_MS=90000    # 90s cooldown per visitor+topic
APP_REGEN_LOCK_COUNT=3         # accepted regenerations before the topic lock
APP_REGEN_LOCK_MS=86400000     # 24h topic lock

# ── Operational ─────────────────────────────────────────────────────────────
# Random string gating the lead-export query (scripts/export-leads.ts).
LEADS_EXPORT_KEY=
# Resend API key for contact-form emails (contact.ts).
RESEND_API_KEY=
